# Copy to .env and fill in. .env is gitignored — never commit, zip, or share it.
# Get a token: log into SAS Viya and use the SAS Viya CLI (sas-viya auth login) or the
# /SASLogon/oauth/token endpoint; tokens issued via authorization_code last ~1 year.
SAS_VIYA_TOKEN=paste-token-here
SAS_VIYA_URL=https://verde-viya.mtes-tt.unx.sas.com/cas-shared-default-http/
CAS_CLIENT_SSL_CA_LIST=C:\path\to\trustedcerts.pem

# Databricks personal access token (local use only; Viya code uses authdomain DATABRICKS_AUTH)
DATABRICKS_TOKEN=paste-databricks-token-here
